{
  "name": "@ondaluz/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R src/sql dist/sql",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "data:load": "tsx src/loader.ts",
    "test": "tsx --test src/**/*.spec.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "pg": "^8.13.3",
    "pg-copy-streams": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
