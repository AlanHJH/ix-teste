# Copie para .env e preencha localmente. O arquivo .env está no .gitignore.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AGENT_OPENAI_TIMEOUT_MS=90000
AGENT_MAX_CONCURRENCY=1
AGENT_REASONING_EFFORT=none
AGENT_METRIC_MAX_TOOL_CALLS=6
AGENT_GROUPING_MAX_CANDIDATES=6
# Modo seguro padrão: propostas aguardam revisão humana. Para o modo opt-in,
# o backend ativa automaticamente apenas propostas de métricas acima do limiar.
AGENT_AUTO_APPROVE_GROUPINGS=false
AGENT_AUTO_APPROVE_MIN_CONFIDENCE=0.9
AGENT_SCHEDULE_MAX_TOOL_CALLS=8
AGENT_MANUAL_MAX_TOOL_CALLS=10
AGENT_MAX_CONTEXT_CHARS=60000
AGENT_MAX_TOOL_OUTPUT_CHARS=10000
AGENT_MAX_PAGE_SIZE=50

# A varredura de candidatos do NOC roda a cada cinco minutos. A revisão temática
# ampla permanece desligada e pode ser executada manualmente na interface.
AGENT_SCHEDULE_ENABLED=false
AGENT_SCHEDULE_INTERVAL_MS=3600000
AGENT_METRIC_TRIGGER_ENABLED=true
AGENT_METRIC_TRIGGER_INTERVAL_MS=300000
